{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "types": ["office-js", "node"]
  },
  "include": ["web/**/*.js", "site/**/*.js", "tests/**/*.js", "scripts/**/*.mjs"],
  "exclude": ["tests/e2e/rj-pb-fake-office.js"]
}
